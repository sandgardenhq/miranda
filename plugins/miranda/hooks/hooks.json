{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/collector/stub.sh\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/collector/stub.sh\" hook-stop || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/collector/stub.sh\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/collector/stub.sh\" hook-stop || true"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/collector/stub.sh\" ] && GLORIA_HOOK_SOURCE=miranda sh \"${CLAUDE_PLUGIN_ROOT}/collector/stub.sh\" hook-session-start || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "[ -f \"${CLAUDE_PLUGIN_ROOT}/collector/stub.sh\" ] && sh \"${CLAUDE_PLUGIN_ROOT}/collector/stub.sh\" hook-post-tool-use || true"
          }
        ]
      }
    ]
  }
}
